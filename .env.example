# Google Sheet Integration (for Contact Form)
# See GOOGLE_SHEETS_SETUP.md for 2-minute setup instructions
VITE_GOOGLE_SHEET_URL=

# AI Assistant API Key (optional - local keyword matching works without this)
# Get a key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# EmailJS Configuration (optional alternative for contact form)
# Sign up at: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
